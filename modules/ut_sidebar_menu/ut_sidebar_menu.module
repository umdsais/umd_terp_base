<?php
/**
 * @file
 * Sidebar Menu module for displaying sidebar navigation blocks and menus.
 *
 * Provides help and theme hooks for sidebar menu and block templates.
 *
 * Implements:
 *   - hook_help(): Displays module help and README.
 *   - hook_theme(): Registers menu and block templates.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 *
 * @inheritdoc
 */
function ut_sidebar_menu_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.ut_sidebar':
      $text = file_get_contents(dirname(__FILE__) . "/README.md");
      $converter = new \League\CommonMark\CommonMarkConverter();
      return $converter->convert($text)->getContent();
  }
  return NULL;
}

/**
 * Implements hook_theme().
 *
 * This hook defines the template.
 * also need to reference this in hook_block_view()
 */
function ut_sidebar_menu_theme($existing, $type, $theme, $path) {
  $theme = [];
  $theme['umd_terp_sidebar_menu__main'] = [
    'base hook' => 'menu',
    'render element' => 'menu',
  ];
  $theme['block__umd_terp_sidebar_menu'] = [
    'base hook' => 'block',
    'render element' => 'block',
  ];
  return $theme;
}
