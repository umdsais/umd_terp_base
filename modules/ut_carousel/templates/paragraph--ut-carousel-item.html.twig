{#
/**
 * @file
 * Theme override to display a UMD Terp Carousel Item Paragraph.
 */
#}

{% if content.field_ut_carousel_item_caption|field_value %}
	<img src="{{ file_url(content.field_ut_carousel_item_image[0]['#media'].field_media_image.entity.uri.value | image_style('UMDDL_carousel')) }}" alt="{{ content.field_ut_carousel_item_image[0]['#media'].field_media_image.alt }}" width="{{ content.field_ut_carousel_item_image[0]['#media'].field_media_image.width }}" height="{{ content.field_ut_carousel_item_image[0]['#media'].field_media_image.height }}" loading="lazy" decoding="async" data-caption="{{ content.field_ut_carousel_item_caption|field_value }}"/>
{% else %}
	<img src="{{ file_url(content.field_ut_carousel_item_image[0]['#media'].field_media_image.entity.uri.value | image_style('UMDDL_carousel')) }}" alt="{{ content.field_ut_carousel_item_image[0]['#media'].field_media_image.alt }}" width="{{ content.field_ut_carousel_item_image[0]['#media'].field_media_image.width }}" height="{{ content.field_ut_carousel_item_image[0]['#media'].field_media_image.height }}" loading="lazy" decoding="async"/>
{% endif %}
