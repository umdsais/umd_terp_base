<?php
/**
 * @file
 * Card module for displaying content in card layouts and groups.
 *
 * Provides help, theme hooks, and preprocess functions for the ut_card paragraph type.
 *
 * Implements:
 *   - hook_help(): Displays module help and README.
 *   - hook_theme(): Registers paragraph templates.
 *   - hook_preprocess_paragraph(): Adds card group style variables.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 *
 * @inheritdoc
 */
function ut_card_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.ut_card':
      $text = file_get_contents(dirname(__FILE__) . "/README.md");
      $converter = new \League\CommonMark\CommonMarkConverter();
      return $converter->convert($text)->getContent();
  }
  return NULL;
}

/**
 * Implements hook_theme().
 *
 * Lets us define our paragraphs templates in this module.
 */
function ut_card_theme($existing, $type, $theme, $path) {
  return [
    'paragraph__ut_card' => [
      'base hook' => 'paragraph',
    ],
    'paragraph__ut_card_group' => [
      'base hook' => 'paragraph',
    ],
    'field__paragraph__field_ut_card_group_cards' => [
      'base hook' => 'paragraph',
    ],
  ];
}

/**
 * Implements hook_preprocess_paragraph().
 *
 * This preproccess gets the column numbers of parent group.
 */
/**
 * This checks what Card Column number is selected.
 * If 2 columns are selected, then the 2 column image style is used
 * If 3 or 4 columns are selected, then the 3 column image style is used
 * this is to resolve an issue where when only a single image style that had been made for 3 columns was used, 2 column images were being upscaled and losing quality
 */
function ut_card_preprocess_paragraph__ut_card(array &$variables) {

  $card = $variables['elements']['#paragraph'];
  $group = $card->getParentEntity();

  $variables['ut_card_image_style'] =
    'umd_terp_card_3_column';

  if (
    $group &&
    $group->hasField('field_ut_card_group_style') &&
    !$group->get('field_ut_card_group_style')->isEmpty()
  ) {
    $variables['ut_card_brightness'] =
      $group->get('field_ut_card_group_style')->value;
  }

  if (
    $group &&
    $group->hasField('field_ut_card_group_columns') &&
    !$group->get('field_ut_card_group_columns')->isEmpty()
  ) {

    $columns =
      $group->get('field_ut_card_group_columns')->value;

    if ($columns === '2') {
      $variables['ut_card_image_style'] =
        'umd_terp_card_2_column';
    }
  }

}



/**
 * Implements hook_field_WIDGET_TYPE_paragraphs_form_alter().
 *
 * Adds "Content Tips" helper text to the paragraph.
 */
function ut_card_field_widget_single_element_paragraphs_form_alter(&$element, $form_state, $context) {
  if ($element['#paragraph_type'] == 'ut_card_group') {
    // Tips text.
    $markup = '<ul>';
    $markup .= '<li><strong>Use two or more cards.</strong> Two cards appear in a two-column grid; three or more cards appear in a three-column grid.</li>';
    $markup .= '<li><strong>Use plain text.</strong>Title and Text should not have styles (bold, italics, etc.).</li>';
    $markup .= '<li><a target="_blank" href="/admin/help/ut_card">Card Module Help</a></li>';
    $markup .= '</ul>';

    $element['ut_card_tips'] = [
      '#type' => 'details',
      '#title' => t('Card Content Tips'),
      '#weight' => -1000,
    ];
    $element['ut_card_tips']['#markup'] = $markup;
  }
}
