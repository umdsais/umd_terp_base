<?php
/**
 * @file
 * Feature module for highlighting content in feature grids.
 *
 * Provides help, theme hooks, and content tips for the ut_feature paragraph type.
 *
 * Implements:
 *   - hook_help(): Displays module help and README.
 *   - hook_theme(): Registers paragraph templates.
 *   - hook_field_WIDGET_TYPE_paragraphs_form_alter(): Adds content tips for editors.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 *
 * @inheritdoc
 */
function ut_feature_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.ut_feature':
      $text = file_get_contents(dirname(__FILE__) . "/README.md");
      $converter = new \League\CommonMark\CommonMarkConverter();
      return $converter->convert($text)->getContent();
  }
  return NULL;
}

/**
 * Implements hook_theme().
 *
 * Lets us define our paragraphs templates in this module.
 */
function ut_feature_theme($existing, $type, $theme, $path) {
  return [
    'paragraph__ut_feature' => [
      'base hook' => 'paragraph',
    ],
  ];
}

/**
 * Implements hook_field_WIDGET_TYPE_paragraphs_form_alter().
 *
 * Adds "Content Tips" helper text to the paragraph.
 */
function ut_feature_field_widget_single_element_paragraphs_form_alter(&$element, $form_state, $context) {
  if ($element['#paragraph_type'] == 'ut_feature') {
    // Tips text.
    $markup = '<ul>';
    $markup .= '<li><strong>These work best as a series.</strong> Use 2-3 stacked features together.</li>';
    $markup .= '<li><strong>Reverse every other feature</strong> for a more dynamic layout.</li>';
    $markup .= '<li><strong>Theme options:</strong> White (default), Light Gray (overlay), or Dark (overlay).</li>';
    $markup .= '<li><a target="_blank" href="/admin/help/ut_feature">Feature Module Help</a></li>';
    $markup .= '</ul>';
    $element['ut_feature_tips'] = [
      '#type' => 'details',
      '#title' => t('Feature Content Tips'),
      '#weight' => -1000,
    ];
    $element['ut_feature_tips']['#markup'] = $markup;
  }
}
