<?php

/**
 * @file
 * Ut_feature module install file.
 */

use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\Entity\FieldConfig;

/**
 * Change field_ut_feature_text field from string (plain text) to text(formatted).
 */
function ut_feature_update_8001() {

  $fields = [
    'field_ut_feature_text' => [
      'table' => 'paragraph__field_ut_feature_text',
      'revision_table' => 'paragraph_revision__field_ut_feature_text',
      'format_col' => 'field_ut_feature_text_format',
    ],
  ];

  $database = \Drupal::database();

  foreach ($fields as $field_name => $f) {
    $table = $f['table'];
    $revision_table = $f['revision_table'];
    $entity_type = 'paragraph';

    // Get field storage.
    $field_storage = FieldStorageConfig::loadByName($entity_type, $field_name);

    // Check if field exist.
    if (is_null($field_storage)) {
      continue;
    }

    // Store data to an array so that we can restore it once the update is complete.
    $rows = NULL;
    $revision_rows = NULL;
    if ($database->schema()->tableExists($table)) {
      $rows = $database->select($table, 'n')->fields('n')->execute()
        ->fetchAll();
      $revision_rows = $database->select($revision_table, 'n')->fields('n')->execute()
        ->fetchAll();
    }

    // Save new field configs & delete existing fields.
    $new_fields = [];
    foreach ($field_storage->getBundles() as $bundle => $label) {
      $field = FieldConfig::loadByName($entity_type, $bundle, $field_name);
      $new_field = $field->toArray();
      $new_field['field_type'] = 'text_long';
      $new_fields[] = $new_field;
      // Delete field.
      $field->delete();
    }

    // Create new storage configs from existing.
    $new_field_storage = $field_storage->toArray();
    $new_field_storage['type'] = 'text_long';
    $new_field_storage['module'] = 'text_long';

    // Purge deleted fields data to create new fields.
    field_purge_batch(250);

    // Create new fieldstorage.
    FieldStorageConfig::create($new_field_storage)->save();

    // Create new fields for all bundles.
    foreach ($new_fields as $new_field) {
      $new_field = FieldConfig::create($new_field);
      $new_field->save();
    }
    // Restore existing data in fields & revision tables.
    if (!is_null($rows)) {
      foreach ($rows as $row) {
        $row = (array) $row;
        $row[$f['format_col']] = 'full_html';
        $database->insert($table)->fields($row)->execute();
      }
    }
    if (!is_null($revision_rows)) {
      foreach ($revision_rows as $row) {
        $row = (array) $row;
        $row[$f['format_col']] = 'full_html';
        $database->insert($revision_table)->fields($row)->execute();
      }
    }
  }
}

/**
 * Add field_ut_feature_theme (White/Light Gray/Dark) to ut_feature paragraph.
 */
function ut_feature_update_8004() {
  $entity_type_manager = \Drupal::entityTypeManager();

  // Create field storage if it doesn't exist.
  if (!FieldStorageConfig::loadByName('paragraph', 'field_ut_feature_theme')) {
    FieldStorageConfig::create([
      'field_name' => 'field_ut_feature_theme',
      'entity_type' => 'paragraph',
      'type' => 'list_string',
      'cardinality' => 1,
      'translatable' => FALSE,
      'settings' => [
        'allowed_values' => [
          'white' => 'White (default)',
          'light' => 'Light Gray',
          'dark'  => 'Dark',
        ],
      ],
    ])->save();
  }

  // Create field instance if it doesn't exist.
  if (!FieldConfig::loadByName('paragraph', 'ut_feature', 'field_ut_feature_theme')) {
    FieldConfig::create([
      'field_name' => 'field_ut_feature_theme',
      'entity_type' => 'paragraph',
      'bundle' => 'ut_feature',
      'label' => 'Theme',
      'description' => 'Sets the background/color theme of the feature element.',
      'required' => FALSE,
      'default_value' => [['value' => 'white']],
    ])->save();
  }

  // Add field to the default form display.
  $form_display = $entity_type_manager
    ->getStorage('entity_form_display')
    ->load('paragraph.ut_feature.default');
  if ($form_display && !$form_display->getComponent('field_ut_feature_theme')) {
    $form_display->setComponent('field_ut_feature_theme', [
      'type' => 'options_select',
      'weight' => 1,
      'region' => 'content',
      'settings' => [],
      'third_party_settings' => [],
    ])->save();
  }
}

/**
 * Update field_ut_feature_theme allowed values: replace maryland with light.
 */
function ut_feature_update_8005() {
  $field_storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('paragraph', 'field_ut_feature_theme');
  if ($field_storage) {
    $field_storage->setSetting('allowed_values', [
      'white' => 'White (default)',
      'light' => 'Light Gray',
      'dark'  => 'Dark',
    ]);
    $field_storage->save();
  }

  // Migrate any existing 'maryland' values to 'white'.
  $database = \Drupal::database();
  foreach (['paragraph__field_ut_feature_theme', 'paragraph_revision__field_ut_feature_theme'] as $table) {
    if ($database->schema()->tableExists($table)) {
      $database->update($table)
        ->fields(['field_ut_feature_theme_value' => 'white'])
        ->condition('field_ut_feature_theme_value', 'maryland')
        ->execute();
    }
  }
}

/**
 * Remove required on style and color fields.
 */
function ut_feature_update_8002() {
  \Drupal::service('config.installer')->installDefaultConfig('module', 'ut_feature');
}

/**
 * Remove old fields for UMD Design Library Update.
 */
function ut_feature_update_8003() {
  // Remove old field.
  if (FieldConfig::loadByName('paragraph', 'ut_feature', 'field_ut_feature_color') !== NULL) {
    FieldConfig::loadByName('paragraph', 'ut_feature', 'field_ut_feature_color')->delete();
  }
  // Remove old field.
  if (FieldConfig::loadByName('paragraph', 'ut_feature', 'field_ut_feature_style') !== NULL) {
    FieldConfig::loadByName('paragraph', 'ut_feature', 'field_ut_feature_style')->delete();
  }

}
