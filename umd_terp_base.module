<?php

/**
 * @file
 * Umd_terp_base module file.
 */

/**
 * Implements hook_preprocess_paragraph().
 *
 * @param $variables
 *   Adds some them settings/info to paragraphs.
 */
function umd_terp_base_preprocess_paragraph(&$variables) {
  // Need some theme settings for asset path/etc.
  if (function_exists('_umd_terp_extend_theme_variables')) {
    _umd_terp_extend_theme_variables($variables);
  }
}

/**
 * Implements hook_form_alter().
 *
 * Adds help text directly to the summary textarea on article and event forms.
 */
function umd_terp_base_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Add title accessibility guidance to all node forms.
  if (isset($form['title']['widget'][0]['value'])) {
    $form['title']['widget'][0]['value']['#description'] = t('Keep titles concise and descriptive. Short titles improve readability, navigation menus, and screen reader accessibility.');
  }

  $summary_forms = [
    'node_umd_terp_article_form',
    'node_umd_terp_article_edit_form',
    'node_umd_terp_event_form',
    'node_umd_terp_event_edit_form',
  ];
  if (in_array($form_id, $summary_forms)) {
    if (isset($form['body']['widget'][0]['summary'])) {
      $form['body']['widget'][0]['summary']['#description'] = t('A brief summary displayed in listings and search results. Keep it to 1–2 sentences.');
    }
  }
}

/**
 * Implements hook_toolbar().
 *
 * Adds admin edit links/tabs in toolbar, so we don't need to have directly on the page.
 */
function umd_terp_base_toolbar() {
  return \Drupal::service('umd_terp_base.edit_button')
    ->addEdit();
}
